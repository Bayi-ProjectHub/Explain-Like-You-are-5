# APP
MAX_UPLOAD_MB=200
MAX_VIDEO_SECONDS=720 # 最长 12 分钟

# AUDIO
WHISPER_MODEL=base # tiny / base / small / medium / large
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
HF_ENDPOINT=https://hf-mirror.com # 镜像

# EVAL
DEEPSEEK_API_KEY=sk- # your DS API key
EVALUATION_MODEL=deepseek-flash

# DELIVERY
# uv sync --extra video 后填写下载的 .task 路径
VIDEO_MODEL_PATH=
# adaptive uses Face Landmarker when Holistic misses face data. dedicated runs it on every sampled frame.
VIDEO_FACE_MODE=adaptive
# Optional ONNX RTMW path. See docs/DELIVERY_HANDOFF.md for weights and runtime.
VIDEO_RTMW_DIR=
VIDEO_RTMW_PRESET=m
VIDEO_RTMW_DEVICE=cpu
# DirectML adapter index when VIDEO_RTMW_DEVICE=dml (Windows)
VIDEO_RTMW_DML_DEVICE_ID=0
