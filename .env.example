# APP
MAX_UPLOAD_MB=200
MAX_VIDEO_SECONDS=720 # 最长 12 分钟

# AUDIO
WHISPER_MODEL=base # tiny / base / small / medium / large
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
HF_ENDPOINT=https://hf-mirror.com # 镜像

# EVAL
DEEPSEEK_API_KEY=
EVALUATION_MODEL=deepseek-flash

# DELIVERY
# uv sync --extra video 后填写下载的 .task 路径
VIDEO_MODEL_PATH=
